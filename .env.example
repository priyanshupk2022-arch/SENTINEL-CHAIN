# ===== SENTINEL-CHAIN Backend Configuration =====
# (Matches backend/app/config.py — the only config surface that matters)

# --- AI Diagnoser (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key
# Any Gemini model id; runtime reads this value (no hardcoding)
GEMINI_MODEL=gemini-3.7-flash

# --- Bright Data Scraper Studio CLI ---
# The CLI reads its own auth; export it here so cli_runner can forward it
BRIGHT_DATA_API_KEY=your_brightdata_api_token

# --- Storage ---
# SQLite WAL database path (created automatically)
DATABASE_PATH=data/sentinel_chain.db

# --- Server ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# --- Self-Healing Engine timeouts (seconds) ---
CLI_TIMEOUT_SECONDS=120
HEAL_TIMEOUT_SECONDS=180

# --- Optional overrides ---
# DEFAULT_COLLECTOR_ID=c_sentinel_cve_threats
# TARGET_DEMO_URL=http://127.0.0.1:8000/api/proxy/target
